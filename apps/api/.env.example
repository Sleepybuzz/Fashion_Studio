# ---- Server ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL 8) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ai_fashion_studio

# ---- Auth ----
# Use a long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Image storage ----
# local = files on this server's disk (lost on hosts with an ephemeral disk such as Render's free tier)
# bunny = files on Bunny.net Edge Storage + CDN (recommended for Render). Fill in the BUNNY_* values below.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Phase 2: max size of an uploaded 3D model (.glb / .gltf), in MB. Stored privately under UPLOAD_DIR/private/garments
MAX_MODEL_MB=25

# ---- Bunny.net (only used when STORAGE_DRIVER=bunny). Keep these ONLY here; never in the web app, a screenshot or a ZIP ----
# Name of your Storage Zone (Bunny dashboard > Storage > your zone)
BUNNY_STORAGE_ZONE=
# The Storage Zone PASSWORD (Storage zone > FTP & API Access > Password). Use the read/write one, not the read-only one.
BUNNY_STORAGE_ACCESS_KEY=
# Storage API hostname for your zone's main region:
#   Falkor/Frankfurt (default): storage.bunnycdn.com | New York: ny.storage.bunnycdn.com | Los Angeles: la.storage.bunnycdn.com
#   Singapore: sg.storage.bunnycdn.com | Sydney: syd.storage.bunnycdn.com | London: uk.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Pull Zone URL connected to the storage zone (no trailing slash). Public product images are served from here.
BUNNY_CDN_URL=
# Optional folder inside the zone, e.g. fashion-studio (leave blank for the zone root)
BUNNY_BASE_PATH=
# BUNNY_TIMEOUT_SECONDS=60

# ---- Seed accounts (local/dev only; leave blank to skip account seeding) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# ---- Phase 3: AI photo virtual try-on -------------------------------------------------------------
# Active provider. Only "genlook" is implemented. Other providers can be added through the adapter registry.
TRYON_PROVIDER=genlook
# Genlook API key (starts with gk_). Create an account at https://platform.genlook.app (10 free credits).
# Keep it ONLY here. Never put it in the web app, a screenshot, or a ZIP. Leave blank to disable try-on.
GENLOOK_API_KEY=
# Optional overrides (defaults shown)
# GENLOOK_API_BASE_URL=https://api.genlook.app/tryon/v1
# How long Genlook keeps uploaded photos/results: 1, 3 or 7 days (default 1)
GENLOOK_KEEP_DAYS=1
# true = Genlook's free test mode: returns the customer's photo unchanged. NOT real AI output. Never use in production.
GENLOOK_TEST_MODE=false
# true = let Genlook crop the photo to 4:5 around the person (default false keeps the original framing)
GENLOOK_CROP_PHOTO=false

# Image limits (MB; the provider accepts up to 10)
MAX_TRYON_PHOTO_MB=8
MAX_TRYON_GARMENT_MB=8

# Cost control (0 = unlimited for the two daily values)
TRYON_USER_HOURLY_LIMIT=12
TRYON_USER_DAILY_LIMIT=10
TRYON_STORE_DAILY_CAP=200
# A try-on still unfinished after this many seconds is marked failed
TRYON_TIMEOUT_SECONDS=240

# Retention on OUR servers (days)
TRYON_UNSAVED_RETENTION_DAYS=7
TRYON_SAVED_RETENTION_DAYS=90
# Lifetime of signed image URLs (seconds)
TRYON_SIGNED_URL_TTL_SECONDS=1800

# ---- Phase 4: real-time AR try-on ---------------------------------------------------------------
# Body tracking runs in the customer's browser: NO API key or AI provider is needed for AR.
# These only control the screenshots a customer chooses to save (private storage: UPLOAD_DIR/private/ar) and admin overlays.
MAX_AR_CAPTURE_MB=4
MAX_AR_OVERLAY_MB=4
# Days a saved screenshot is kept before automatic deletion
AR_CAPTURE_RETENTION_DAYS=90
# Saved screenshots per customer, and saves per customer per hour
AR_MAX_CAPTURES_PER_USER=30
AR_CAPTURE_HOURLY_LIMIT=30
# Lifetime of signed screenshot URLs (seconds)
AR_SIGNED_URL_TTL_SECONDS=1800

# ---- Phase 5: AI chat customization --------------------------------------------------------------
# Three INDEPENDENT providers. Change a name, then RESTART the API (.env is read only at startup).
# An unknown name stops startup. A missing key only disables that capability. There is NO automatic fallback to another provider.
CHAT_AI_PROVIDER=gemini
# cloudflare | photoroom
IMAGE_EDIT_PROVIDER=photoroom
# TRYON_PROVIDER (above) selects the try-on provider.

# Chat provider: Google Gemini (key stays on the server; never use a VITE_ variable for it)
GEMINI_API_KEY=
# Required: choose a current Gemini model from Google's docs that supports JSON output and your free/paid tier
GEMINI_CHAT_MODEL=
# GEMINI_API_BASE_URL=
# GEMINI_TIMEOUT_SECONDS=30

# Image edit provider: PhotoRoom "Edit With AI" (Image Editing API, Plus plan). Key stays on the server.
# Start with a sandbox key (sandbox_xxxx): free, watermarked. Get it at https://app.photoroom.com/api-dashboard
PHOTOROOM_API_KEY=
# PHOTOROOM_API_BASE_URL=https://image-api.photoroom.com
# PHOTOROOM_TIMEOUT_SECONDS=120

# (Optional, only if IMAGE_EDIT_PROVIDER=cloudflare) Cloudflare Workers AI (FLUX.1 Kontext Pro). This model is PAID per image; check Cloudflare pricing.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=black-forest-labs/flux-1-kontext-pro
# CLOUDFLARE_API_BASE_URL=
# CLOUDFLARE_TIMEOUT_SECONDS=180

# Customer uploads (private storage: UPLOAD_DIR/private/ai)
MAX_AI_UPLOAD_MB=8
AI_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
AI_UPLOAD_MIN_SIDE=400

# Cost and abuse controls
AI_EDIT_USER_HOURLY_LIMIT=10
AI_EDIT_USER_DAILY_LIMIT=20
AI_EDIT_STORE_DAILY_CAP=150
AI_CHAT_USER_HOURLY_LIMIT=60
AI_MAX_SESSIONS_PER_USER=20
AI_MAX_VERSIONS_PER_SESSION=30
AI_MAX_SAVED_PER_USER=30
AI_MAX_MESSAGE_CHARS=600
AI_CHAT_HISTORY_TURNS=12
AI_EDIT_TIMEOUT_SECONDS=240

# Retention (days) and signed image URL lifetime (seconds)
AI_UNSAVED_RETENTION_DAYS=7
AI_SAVED_RETENTION_DAYS=90
AI_SIGNED_URL_TTL_SECONDS=1800

# ---- Phase 7: deployment / hardening ---------------------------------------------------------------
# Number of reverse proxies in front of the API (nginx = 1). Leave 0 when the API is exposed directly.
TRUST_PROXY=0
# FRONTEND_URL (above) may list several origins separated by commas, e.g. https://demo.example.com,https://www.demo.example.com
# Coarse per-IP limit over all /api routes, requests per minute (0 = off)
API_RATE_LIMIT_PER_MINUTE=300
DB_POOL_SIZE=10
REQUEST_TIMEOUT_SECONDS=300
