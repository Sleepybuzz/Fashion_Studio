# ---- Server ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL 8) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ai_fashion_studio

# ---- Auth ----
# Use a long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Image storage ----
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Phase 2: max size of an uploaded 3D model (.glb / .gltf), in MB. Stored privately under UPLOAD_DIR/private/garments
MAX_MODEL_MB=25

# ---- Seed accounts (local/dev only; leave blank to skip account seeding) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# ---- Phase 3: AI photo virtual try-on -------------------------------------------------------------
# Active provider. Only "genlook" is implemented. Other providers can be added through the adapter registry.
TRYON_PROVIDER=genlook
# Genlook API key (starts with gk_). Create an account at https://platform.genlook.app (10 free credits).
# Keep it ONLY here. Never put it in the web app, a screenshot, or a ZIP. Leave blank to disable try-on.
GENLOOK_API_KEY=
# Optional overrides (defaults shown)
# GENLOOK_API_BASE_URL=https://api.genlook.app/tryon/v1
# How long Genlook keeps uploaded photos/results: 1, 3 or 7 days (default 1)
GENLOOK_KEEP_DAYS=1
# true = Genlook's free test mode: returns the customer's photo unchanged. NOT real AI output. Never use in production.
GENLOOK_TEST_MODE=false
# true = let Genlook crop the photo to 4:5 around the person (default false keeps the original framing)
GENLOOK_CROP_PHOTO=false

# Image limits (MB; the provider accepts up to 10)
MAX_TRYON_PHOTO_MB=8
MAX_TRYON_GARMENT_MB=8

# Cost control (0 = unlimited for the two daily values)
TRYON_USER_HOURLY_LIMIT=12
TRYON_USER_DAILY_LIMIT=10
TRYON_STORE_DAILY_CAP=200
# A try-on still unfinished after this many seconds is marked failed
TRYON_TIMEOUT_SECONDS=240

# Retention on OUR servers (days)
TRYON_UNSAVED_RETENTION_DAYS=7
TRYON_SAVED_RETENTION_DAYS=90
# Lifetime of signed image URLs (seconds)
TRYON_SIGNED_URL_TTL_SECONDS=1800
