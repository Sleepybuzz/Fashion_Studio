{
  "name": "ai-fashion-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "AI Fashion Studio - single-vendor clothing store (Phase 3: AI Photo Virtual Try-On)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "build:web": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "sample:garment": "npm run sample:garment -w apps/api",
    "tryon:cleanup": "npm run tryon:cleanup -w apps/api"
  }
}
